{
  "name": "@rafflex/dev",
  "version": "0.1.0",
  "description": "Build, preview, and check Rafflex marketplace games and blocks locally, with the platform's own rules.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rafflex-dev": "bin/rafflex-dev.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:parity": "node --test test/parity.live.js"
  },
  "keywords": [
    "rafflex",
    "twig",
    "preview",
    "dev-server"
  ],
  "homepage": "https://marketplace.rafflex.io/docs/dev-kit.md",
  "dependencies": {
    "alpinejs": "^3.17.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "prettier": "3.9.9",
    "twig": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "heroicons": "2.2.0",
    "playwright-core": "1.63.0"
  }
}
